  font-weight: 900;
}

.admin-secondary-nav__items {
  display: grid;
  gap: 6px;
}

.admin-secondary-nav__item {
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid transparent;
  border-radius: var(--radius-control);
  background: transparent;
  color: var(--ink-soft);
  font-weight: 850;
  line-height: 1.2;
  text-align: left;
