  border-radius: var(--radius-control);
  background: var(--surface-soft);
  color: var(--ink-soft);
  font-weight: 850;
  cursor: pointer;
  text-align: left;
}

.item-context-menu__option:hover,
.item-context-menu__option:focus-visible {
