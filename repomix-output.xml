  game_version_id integer REFERENCES game_versions(id) ON DELETE SET NULL,
  ai_moderation_status text NOT NULL DEFAULT 'unreviewed' CHECK (ai_moderation_status IN ('unreviewed', 'reviewing', 'approved', 'rejected', 'failed')),
